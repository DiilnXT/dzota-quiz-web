generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Subject {
  id        String    @id @default(cuid())
  name      String
  chapters  Chapter[]
  createdAt DateTime  @default(now())
}

model Chapter {
  id        String          @id @default(cuid())
  name      String
  subjectId String
  subject   Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions QuestionGroup[]
  createdAt DateTime        @default(now())
}

model QuestionGroup {
  id        String     @id @default(cuid())
  name      String     // e.g., "Câu 1 - Đạo hàm cơ bản"
  chapterId String
  chapter   Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions Question[]
  createdAt DateTime   @default(now())
}

model Question {
  id            String        @id @default(cuid())
  groupId       String
  group         QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  content       String        // HTML/Text content
  options       String        // JSON string of options {A: "...", B: "..."}
  correctOption String
  explanation   String?
  createdAt     DateTime      @default(now())
  testQuestions TestQuestion[]
}

model Test {
  id          String         @id @default(cuid())
  title       String
  description String?
  password    String?
  timeLimit   Int            // minutes
  mode        String         // exam, practice
  isActive    Boolean        @default(true)
  settings    String?        // JSON of generation settings (e.g., how many questions from each chapter)
  questions   TestQuestion[]
  createdAt   DateTime       @default(now())
}

model TestQuestion {
  id         String   @id @default(cuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId String   // points to a specific Question (variation)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
}

model QuickQuiz {
  id        String   @id @default(cuid())
  title     String
  data      String   // JSON string containing the full original app's quiz data
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model User {
  id                  String             @id @default(cuid())
  username            String             @unique
  email               String?            @unique
  name                String?
  password            String
  role                String             @default("STUDENT")
  maxTests            Int                @default(10)
  avatar              String?
  phone               String?            // Zalo phone number (10 digits, starts with 0)
  lastActiveAt        DateTime?
  createdAt           DateTime           @default(now())
  quizzes             QuickQuiz[]
  notifications       Notification[]
  history             QuizHistory[]
  classes             Classroom[]        @relation("TeacherClasses")
  sentFriendships     Friendship[]       @relation("SentFriendships")
  receivedFriendships Friendship[]       @relation("ReceivedFriendships")
  sentMessages        ChatMessage[]      @relation("SentMessages")
  receivedMessages    ChatMessage[]      @relation("ReceivedMessages")
  mistakeAnalyses     MistakeAnalysis[]
}

model Friendship {
  id           String   @id @default(cuid())
  requesterId  String
  requester    User     @relation("SentFriendships", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId  String
  addressee    User     @relation("ReceivedFriendships", fields: [addresseeId], references: [id], onDelete: Cascade)
  status       String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([requesterId, addresseeId])
}

model ChatMessage {
  id                 String   @id @default(cuid())
  senderId           String
  sender             User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId         String
  receiver           User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content            String
  type               String   @default("TEXT") // TEXT, QUIZ
  quizId             String?
  quizTitle          String?
  isRecalled         Boolean  @default(false)
  deletedForSender   Boolean  @default(false)
  deletedForReceiver Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model QuizHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId       String
  quizTitle    String
  score        Float
  correctCount Int
  totalCount   Int
  timeSpent    Int      @default(0) // seconds
  details      String?  // JSON string of answers / details
  createdAt    DateTime @default(now())
}

model Classroom {
  id          String             @id @default(cuid())
  name        String
  description String?
  teacherId   String
  teacher     User               @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  students    ClassroomStudent[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model ClassroomStudent {
  id              String    @id @default(cuid())
  classId         String
  class           Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  email           String
  name            String?
  allowedSubjects String?   // JSON string array of subject names
  allowedQuizIds  String?   // JSON string array of quiz IDs
  createdAt       DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model MistakeAnalysis {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId       String
  quizTitle    String
  subject      String?
  mistakeCount Int      @default(0)
  analysisText String   // Markdown content of the AI analysis
  createdAt    DateTime @default(now())
}


